{
  "name": "mattstein/alfred-tower-bookmarks-workflow",
  "type": "project",
  "description": "Launch Tower bookmarks from Alfred.",
  "keywords": [
    "alfred",
    "tower"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "joetannenbaum/alfred-workflow": "dev-master",
    "rodneyrehm/plist": "dev-main"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/mattstein/alfred-workflow"
    },
    {
      "type": "vcs",
      "url": "https://github.com/moodlehq/CFPropertyList"
    }
  ],
  "scripts": {
    "test": "pest"
  },
  "require-dev": {
    "pestphp/pest": "^3.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
